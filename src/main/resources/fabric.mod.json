{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [],
  "contact": {},
  "license": "BSD-3-Clause",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.odtheking.odinaddon.OdinAnimations"
      }
    ]
  },
  "mixins": [
    "odinaddon.mixins.json"
  ],
  "accessWidener": "odinaddon.accesswidener",
  "depends": {
    "minecraft": ">=${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "odin": ">=${odin_version}"
  }
}